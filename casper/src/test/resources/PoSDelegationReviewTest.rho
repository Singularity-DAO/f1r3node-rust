//scalapackage coop.rchain.rholang.mint

//requires Pos, RhoSpec

new
  rl(`rho:registry:lookup`),
  vaultAddressOps(`rho:vault:address`),
  RhoSpecCh,
  PoSCh,
  SystemVaultCh,
  setup,
  prepareUser,
  test_delegation_review_guards
in {
  rl!(`rho:system:pos`, *PoSCh) |
  rl!(`rho:vault:system`, *SystemVaultCh) |
  rl!(`rho:id:zphjgsfy13h1k85isc8rtwtgt3t9zzt5pjd5ihykfmyapfc4wt3x5h`, *RhoSpecCh) |
  for(@(_, RhoSpec) <- RhoSpecCh &
      @(_, PoS) <- PoSCh &
      @(_, SystemVault) <- SystemVaultCh) {
    @RhoSpec!("testSuite", *setup,
      [
        ("delegation review guards", *test_delegation_review_guards)
      ]
    ) |

    contract setup(_, retCh) = {
      retCh!({})
    } |

    contract prepareUser(@pk, retCh) = {
      new makeDeployerId(`rho:test:deployerId:make`),
          deployerIdCh,
          vaultAddrCh,
          vaultCh
      in {
        vaultAddressOps!("fromPublicKey", pk.hexToBytes(), *vaultAddrCh) |
        makeDeployerId!("deployerId", pk.hexToBytes(), *deployerIdCh) |
        for (@vaultAddress <- vaultAddrCh &
             @deployerId <- deployerIdCh) {
          @SystemVault!("findOrCreate", vaultAddress, *vaultCh) |
          for (@(true, vault) <- vaultCh) {
            retCh!(pk.hexToBytes(), vaultAddress, vault, deployerId)
          }
        }
      }
    } |

    contract test_delegation_review_guards(rhoSpec, _, ackCh) = {
      new validatorSetupCh,
          delegatorSetupCh,
          bondCh,
          minimumBondCh,
          dustDelegateCh,
          invalidDelegateCh,
          invalidUndelegateCh,
          delegateCh,
          rebondCh,
          undelegateCh,
          secondUndelegateCh,
          selfBondsCh,
          effectiveBondsCh,
          delegatedTotalsCh,
          pendingUndelegationsCh,
          epochCh, quarantineCh,
          guardsAckCh, withdrawCh, withdrawersCh, pendingAfterWithdrawCh,
          setBlockData(`rho:test:block:data:set`),
          blockDataCh
      in {
        prepareUser!("6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a6a", *validatorSetupCh) |
        prepareUser!("7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b", *delegatorSetupCh) |
        for (@validatorPubKey, _, _, @validatorDeployerId <- validatorSetupCh &
             @delegatorPubKey, _, _, @delegatorDeployerId <- delegatorSetupCh) {
          match (100000000000000000000n, 40000000000000000000n, 10000000000000000000n, 10) {
            (validatorBond, delegationAmt, undelegationAmt, requestBlock) => {
              @PoS!("bond", validatorDeployerId, validatorBond, *bondCh) |
              for (@(true, _) <- bondCh) {
                @PoS!("getMinimumBond", *minimumBondCh) |
                for (@minimumBond <- minimumBondCh) {
                  @PoS!("delegate", delegatorDeployerId, validatorPubKey, minimumBond - 1n, *dustDelegateCh) |
                  @PoS!("delegate", delegatorDeployerId, validatorPubKey, 2, *invalidDelegateCh) |
                  @PoS!("undelegate", delegatorDeployerId, validatorPubKey, 2, *invalidUndelegateCh) |
                  for (@(false, dustMsg) <- dustDelegateCh &
                       @(false, invalidDelegateMsg) <- invalidDelegateCh &
                       @(false, invalidUndelegateMsg) <- invalidUndelegateCh) {
                    @PoS!("delegate", delegatorDeployerId, validatorPubKey, delegationAmt, *delegateCh) |
                    for (@(true, _) <- delegateCh) {
                      @PoS!("bond", validatorDeployerId, 50n, *rebondCh) |
                      for (@(false, rebondMsg) <- rebondCh) {
                        setBlockData!("blockNumber", requestBlock, *blockDataCh) |
                        for (_ <- blockDataCh) {
                          @PoS!("undelegate", delegatorDeployerId, validatorPubKey, undelegationAmt, *undelegateCh) |
                          for (@(true, _) <- undelegateCh) {
                            @PoS!("undelegate", delegatorDeployerId, validatorPubKey, 1n, *secondUndelegateCh) |
                            for (@(false, secondMsg) <- secondUndelegateCh) {
                              @PoS!("getBonds", *selfBondsCh) |
                              @PoS!("getEffectiveBonds", *effectiveBondsCh) |
                              @PoS!("getDelegatedTotals", *delegatedTotalsCh) |
                              @PoS!("getPendingUndelegations", *pendingUndelegationsCh) |
                              @PoS!("getEpochLength", *epochCh) |
                              @PoS!("getQuarantineLength", *quarantineCh) |
                              for (@selfBonds <- selfBondsCh &
                                   @effectiveBonds <- effectiveBondsCh &
                                   @delegatedTotals <- delegatedTotalsCh &
                                   @pendingUndelegations <- pendingUndelegationsCh &
                                   @epochLength <- epochCh &
                                   @quarantineLength <- quarantineCh) {
                                rhoSpec!("assertMany",
                                  [
                                    ((2n, "==", minimumBond), "minimum bond getter exposes genesis parameter"),
                                    ((10, "==", epochLength), "test epoch length is ten blocks"),
                                    ((15, "==", quarantineLength), "test quarantine is not a whole number of epochs"),
                                    (("Delegation amount must be a BigInt.", "==", invalidDelegateMsg), "Int delegation is rejected"),
                                    (("Undelegation amount must be a BigInt.", "==", invalidUndelegateMsg), "Int undelegation is rejected"),
                                    (("Delegation is less than minimum.", "==", dustMsg), "delegation below minimumBond is rejected"),
                                    (("Public key is already bonded.", "==", rebondMsg), "bond cannot mutate an already bonded validator after delegation"),
                                    (("Pending undelegation already exists for validator.", "==", secondMsg), "a second pending undelegation for the pair is rejected"),
                                    ((validatorBond, "==", selfBonds.get(validatorPubKey)), "self-bond stays unchanged"),
                                    ((delegationAmt - undelegationAmt, "==", delegatedTotals.getOrElse(validatorPubKey, 0n)), "delegated total reflects the active remainder"),
                                    (((validatorBond + delegationAmt) - undelegationAmt, "==", effectiveBonds.get(validatorPubKey)), "effective bond reflects self plus active delegated remainder"),
                                    (((undelegationAmt, 40), "==", pendingUndelegations.getOrElse(delegatorPubKey, {}).get(validatorPubKey)), "delegation escrow covers the rounded validator payout block")
                                  ],
                                  *guardsAckCh
                                ) |
                                for (_ <- guardsAckCh) {
                                  @PoS!("withdraw", validatorDeployerId, *withdrawCh) |
                                  for (@(true, _) <- withdrawCh) {
                                    @PoS!("getPendingWithdrawer", *withdrawersCh) |
                                    @PoS!("getPendingUndelegations", *pendingAfterWithdrawCh) |
                                    for (@withdrawers <- withdrawersCh &
                                         @pendingAfterWithdraw <- pendingAfterWithdrawCh) {
                                      rhoSpec!("assertMany",
                                        [
                                          ((35, "==", withdrawers.get(validatorPubKey)), "validator quarantine keeps the dev policy"),
                                          (((delegationAmt, 40), "==", pendingAfterWithdraw.get(delegatorPubKey).get(validatorPubKey)), "withdraw combines pending principal at the rounded payout block")
                                        ],
                                        *ackCh
                                      )
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
